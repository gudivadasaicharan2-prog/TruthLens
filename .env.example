# TruthLens Production Environment Variables

# ============================================================
# REQUIRED SECRETS - MUST BE SET IN PRODUCTION
# ============================================================

# Database Configuration
DATABASE_URL=postgresql://postgres:your-strong-password-here@localhost:5432/truthlens

# Security Secrets (MUST be at least 32 characters, use random strings)
SECRET_KEY=your-secret-key-min-32-characters-long-change-this-in-production
JWT_SECRET=your-jwt-secret-min-32-characters-long-change-this-in-production

# ============================================================
# OPTIONAL CONFIGURATION
# ============================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Token Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/gif,image/bmp

# CORS Configuration (comma-separated list of allowed origins)
# In production, specify exact origins. Do not use wildcard.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# External API Keys (Optional)
GOOGLE_CLIENT_ID=
NEWS_API_KEY=
GNEWS_API_KEY=
HF_TOKEN=

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=200

# Security Headers Configuration
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================

VITE_API_URL=http://localhost:8000
VITE_ENABLE_ANALYTICS=false
